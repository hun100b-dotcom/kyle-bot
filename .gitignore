# 환경변수(실제 비밀값). .env.example 견본만 커밋하고 실제 .env 는 절대 커밋 금지.
.env
.env.*
!.env.example

# 현황판 HTML(실계좌 잔고가 담기므로 커밋 금지. 로컬에서만 열람)
report.html

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 빌드 산출물(용량 큼) — 코드가 아니라 결과물이므로 커밋 금지
release
dist-electron

# 웹앱(PWA) 빌드 결과 — 소스가 아니라 산출물이므로 추적하지 않는다
dist-web/

# Supabase CLI 로컬 캐시(버전 정보 등, 기기마다 다름 — 코드 아님)
supabase/.temp/

# 실계좌 숫자가 든 로컬 전용 진행 기록 + 키/인증서 파일 (공개 레포 전환 때 추가)
docs/progress.md
*.pem
