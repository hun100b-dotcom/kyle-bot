#!/bin/sh
# =============================================================================
# build/pkg-scripts/postinstall — 설치가 끝난 직후 macOS가 자동으로 실행하는 스크립트
# -----------------------------------------------------------------------------
# [이게 왜 필요한가 — 실제로 겪은 사고]
#   신규 팀원(M1 맥북프로)이 릴리스에서 앱을 받아 실행했더니 **로그인 창이 0.4초쯤
#   떴다가 그냥 사라지는** 일이 났다(2026-10-16, 영상으로 확인). 에러창은 하나도 안 떴다.
#
#   원인은 macOS가 "인터넷에서 받은 파일"에 몰래 붙이는 **격리 꼬리표(quarantine)** 다.
#   이 앱은 애플 개발자 인증서(연 유료)가 없어 애드혹 서명(identity: "-")으로 나가는데,
#   애플 실리콘(M1 이후)에서 "격리 꼬리표 + 애드혹 서명" 조합은 앱을 띄우다 말고 죽인다.
#
#   electron/mac-self-update.ts 는 **자동 업데이트로 앱을 갈아끼울 때는** 이미 똑같은
#   일(`xattr -cr`)을 하고 있다. 그런데 **사람이 손으로 내려받아 설치할 때는** 그 과정이
#   아예 없어서, 신규 팀원만 이 사고를 겪었다. 그 빈틈을 이 스크립트가 메운다.
#
# [언제 실행되나] 설치 프로그램(.pkg)이 앱을 복사한 바로 다음, **관리자 권한으로** 한 번.
#   사용자는 아무것도 안 해도 된다 — 터미널을 열 필요가 없다는 게 이 파일의 존재 이유다.
#
# [왜 두 가지를 다 하나]
#   ① xattr -cr   : 격리 꼬리표를 앱 안쪽까지 싹 지운다(원인 제거).
#   ② codesign    : 압축을 풀고 옮기는 과정에서 서명이 깨졌을 수 있으니 애드혹으로 다시
#                   찍는다. 깨진 서명도 애플 실리콘에서 같은 증상(즉시 종료)을 낸다.
#
# [절대 실패로 끝내지 않는다]
#   둘 중 하나가 실패해도 `exit 0` 으로 끝낸다. 설치 자체를 실패시키면 사용자는 앱을
#   아예 못 쓰게 된다 — 꼬리표 제거가 안 된 앱은 "우클릭 → 열기"로 여전히 쓸 수 있으므로,
#   여기서 설치를 막는 쪽이 훨씬 나쁘다.
# =============================================================================

# macOS 설치 프로그램이 넘겨주는 인자: $2 = 설치 위치(보통 /Applications)
TARGET="${2:-/Applications}"
APP="$TARGET/Capri.app"

# 설치 위치를 못 찾으면 기본 경로로 한 번 더 시도(사용자가 경로를 바꿨을 때 대비)
[ -d "$APP" ] || APP="/Applications/Capri.app"
[ -d "$APP" ] || exit 0   # 앱을 못 찾으면 조용히 끝낸다(설치는 성공 처리)

# ① 격리 꼬리표 제거 — 이 한 줄이 "실행하면 바로 꺼짐"의 직접적인 해결책이다.
/usr/bin/xattr -cr "$APP" 2>/dev/null

# ② 애드혹 서명 재적용 — 옮기는 과정에서 깨진 서명을 복구한다.
/usr/bin/codesign --force --deep --sign - "$APP" 2>/dev/null

# ③ [v0.107.0] 앱 소유자를 "지금 로그인한 사람"으로 바꾼다.
#   설치팩은 관리자(root) 권한으로 깔리기 때문에 앱 폴더 주인이 root가 된다. 그러면 나중에 앱이
#   자동 업데이트로 자기 자신을 갈아끼울 때(electron/mac-self-update.ts) 일반 권한으로는 못 옮겨
#   교체가 실패할 수 있다(2026-10-21 "재시작 후 안 켜짐" 사고의 원인 후보). 주인을 사용자로
#   바꿔 두면 매번 암호를 묻지 않고 조용히 업데이트된다.
CONSOLE_USER="$(/usr/bin/stat -f%Su /dev/console 2>/dev/null)"
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
  /usr/sbin/chown -R "$CONSOLE_USER":staff "$APP" 2>/dev/null
fi

# ④ 예전 자동 업데이트가 남긴 백업/실패 폴더가 있으면 치운다(관리자 소유라 앱이 못 지운 것).
/bin/rm -rf "$APP".capri-update-backup* "$APP.capri-failed" 2>/dev/null

exit 0
