{
  "name": "kyle-bot",
  "private": true,
  "version": "0.36.0",
  "description": "Capri 매매도구 — Capri매매기법 계산기 + 토스 조건주문 (v0.2: 주문 잠금/드라이런)",
  "author": "hun100b",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "report": "tsx scripts/report.ts",
    "app:compile": "esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --external:electron-updater --outfile=dist-electron/main.cjs && node -e \"require('fs').copyFileSync('electron/preload.cjs','dist-electron/preload.cjs')\"",
    "app": "npm run build && npm run app:compile && electron .",
    "app:dist": "npm run dist:mac",
    "icon": "node scripts/make-icon.mjs",
    "ship": "node scripts/ship.mjs",
    "relay": "tsx scripts/relay.mjs",
    "web:dev": "vite --config vite.web.config.ts",
    "web:check": "tsc -p tsconfig.web.json --noEmit",
    "web:build": "npm run web:check && vite build --config vite.web.config.ts && node scripts/stamp-sw.mjs",
    "web:deploy": "npm run web:build && node scripts/deploy-web.mjs",
    "dist:win": "npm run build && npm run app:compile && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && npm run app:compile && electron-builder --mac --publish never",
    "publish:release": "node scripts/publish-release.mjs",
    "release:win": "npm run dist:win && node scripts/publish-release.mjs",
    "release:mac": "npm run dist:mac && node scripts/publish-release.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.6",
    "electron-updater": "^6.8.9",
    "luxon": "^3.7.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "oxlint": "^1.71.0",
    "pg-query-emscripten": "^5.1.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
