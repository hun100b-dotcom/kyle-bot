{
  "name": "kyle-bot",
  "private": true,
  "version": "0.1.0",
  "description": "카일봇 — 토스 미국주식(데이마켓) 자동매매 데스크톱 앱 (v0.1: 드라이런 전용)",
  "author": "hun100b",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx scripts/demo.ts",
    "report": "tsx scripts/report.ts",
    "app:compile": "esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/main.cjs && cp electron/preload.cjs dist-electron/preload.cjs",
    "app": "npm run build && npm run app:compile && electron .",
    "app:dist": "npm run build && npm run app:compile && electron-builder --mac dmg"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.6",
    "luxon": "^3.7.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "oxlint": "^1.71.0",
    "pg-query-emscripten": "^5.1.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
