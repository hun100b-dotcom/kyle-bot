# =============================================================================
# .env.example  —  Capri가 필요로 하는 환경변수 "목록"만 적어둔 견본 파일
# -----------------------------------------------------------------------------
# [중요·보안] 이 파일에는 절대 진짜 값을 넣지 않습니다. "이런 이름의 값이 필요하다"는
#   설명만 담습니다. 실제 비밀값(client secret 등)은 이 PC의 로컬 .env 파일(gitignore됨)
#   이나 OS 환경변수에만 넣고, 코드나 git 커밋에는 절대 포함하지 않습니다.
#   (아키텍처: Capri은 웹 배포가 아니라 내 PC에서 상시 실행하는 로컬 프로그램입니다.)
#
# [왜 이렇게 하나?]
#   client secret이 git에 한 번이라도 올라가면, 나중에 지워도 히스토리에 남아
#   유출됩니다. 유출되면 남이 내 계좌로 주문을 낼 수 있어 매우 위험합니다.
#   그래서 "값은 서버에만, 코드에는 이름만" 원칙을 지킵니다.
#
# [프론트엔드 노출 금지]
#   Vite는 VITE_ 로 시작하는 변수만 브라우저(프론트) 번들에 넣습니다.
#   아래 변수들은 일부러 VITE_ 접두사를 안 붙였습니다 → 브라우저(Electron 렌더러) 쪽으로
#   새어나가지 않고, 백그라운드 Node 워커(메인 프로세스)에서만 읽힙니다.
#   토스 키는 반드시 이 워커(서버 격) 쪽에서만 씁니다.
#
# [사용법] 로컬에서 테스트할 때만 이 파일을 복사해 .env(git 무시됨)로 만들고
#   값을 채웁니다. .env 는 절대 커밋하지 않습니다.
# =============================================================================

# 토스 Open API 기본 주소(스펙 확정 시 실제 도메인으로).
TOSS_BASE_URL=

# 앱 등록 시 발급받는 클라이언트 ID(공개되어도 되는 식별자).
TOSS_CLIENT_ID=

# 클라이언트 시크릿(절대 비밀! 서버 환경변수에만).
TOSS_CLIENT_SECRET=

# 주문/계좌 API에 붙이는 계좌 식별자(X-Tossinvest-Account 헤더 값).
# 한 사용자가 여러 계좌를 가질 수 있어, 어느 계좌인지 지정해야 합니다.
TOSS_ACCOUNT=
